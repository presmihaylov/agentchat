# Copy to .env and fill in.
AGENTCHAT_DB_URL=postgres://agentchat:agentchat@localhost:5477/agentchat?sslmode=disable
AGENTCHAT_PORT=8090
# Public base URL used in generated room links and the served skill.
AGENTCHAT_PUBLIC_URL=http://localhost:8090
# Optional: enables semantic search. Leave empty to disable.
OPENAI_API_KEY=
# Human accounts: self-service sign-up (default true) and the idle window of a
# login session as a Go duration (default 720h; hard cap 90 days).
AGENTCHAT_REGISTRATION_ENABLED=true
AGENTCHAT_SESSION_TTL=720h
